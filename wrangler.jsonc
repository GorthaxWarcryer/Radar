{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "azeroth-radar",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "azeroth-radar-db"
    }
  ],
  "triggers": {
    "crons": [
      "26 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
