# Do not commit .env or publish credentials. Set variables as deployment secrets.
# Local default: HOST=127.0.0.1 PORT=4173. Render sets PORT; set NODE_ENV=production.
# HOST=0.0.0.0
# PORT=4173
# Required for ANY public deployment, use a freshly generated strong random value.
ADMIN_TOKEN=
# Render uses a mounted disk at /data; set DB_PATH=/data/azeroth.sqlite there.
# DB_PATH=/data/azeroth.sqlite
# Add when you are ready to enable LIVE YouTube scans (do not paste into chat).
YOUTUBE_API_KEY=
# Comma-separated YouTube channel IDs (UC...) or @handles to monitor.
YOUTUBE_CHANNELS=
# Optional Reddit API, only if you have approved API access.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AzerothRadarRebuild/0.2 (contact: your-contact)
REDDIT_SUBREDDITS=wowforever,classicwow,wow
# Optional approved first-party official-post JSON endpoint.
OFFICIAL_POSTS_JSON_URL=
AUTO_SCAN=true

# Incremental/restart-safe scan limits. Default: 60s worker, 2 channels per
# run, 50 YouTube videos max per detail request. A failed batch stays queued.
SCAN_BUDGET_MS=60000
YOUTUBE_CHANNELS_PER_SCAN=2
YOUTUBE_VIDEOS_PER_SCAN=50
